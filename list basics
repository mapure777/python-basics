to do list app.
tasks = [] #creating an empty list
while True: # infinite loop
    print("\n---To-Do List Menu ---")
    print("1.Add a tasks")
    print("2. view tasks")

    print("3.Remove a task")
    print("4. Exit")
    choice =int( input("\nChoose an option (1-4): "))
    if choice == 1:
        task = input("Enter the task to add: ")
        tasks.append(task)
        print("Task" + task + " added!")

    elif choice == 2:
        for i in tasks:
            print(i) 

    elif choice == 3:
        task = input("Enter the name of the task you want to remove:")
        tasks.remove(task)
        print("Task" + task + "removed!")
    elif choice== 4:
        print("Exiting To-Do List App. Goodbye!")
        break
